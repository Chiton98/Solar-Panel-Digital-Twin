<?xml version='1.0'?>

<robot name="Panel">
    <!--Eslabones-->
        <!--Base del robot-->
            <link name="base_link">
                <visual>
                    <geometry>
                    <mesh filename = "package://panel/src/panel_description/meshes/Base.stl"/>
                    </geometry>
                </visual>
                
                <collision>
                    <geometry>
                    <mesh filename = "package://panel/src/panel_description/meshes/Base.stl"/>
                    </geometry>
                </collision>
          
            </link>

        <!--Eslabón 1: Porteria-->
            <link name="porteria_link">
                <visual>
                    <geometry>
                    <mesh filename = "package://panel/src/panel_description/meshes/Porteria.stl"/>
                    </geometry>
                </visual>
                
                <collision>
                    <geometry>
                    <mesh filename = "package://panel/src/panel_description/meshes/Porteria.stl"/>
                    </geometry>
                </collision>
            </link>


        <!--Eslabón 2: Panel-->
            <link name="panel_link">
                <visual>
                    <geometry>
                    <mesh filename = "package://panel/src/panel_description/meshes/Panel.dae"/>
                    </geometry>
                </visual>
                
                <collision>
                    <geometry>
                    <mesh filename = "package://panel/src/panel_description/meshes/Panel.dae"/>
                    </geometry>
                </collision>
            </link>

    <!--Uniones del robot-->

    <!--Union 1-->
     <joint name = "J1" type = "continuous">
      <parent link = "base_link"/>
      <child link = "porteria_link"/>
      <origin xyz = "0 0 0.0175" rpy = "0 0 0"/>
      <axis xyz ="0 0 1" />
     </joint>

    <!--Union 2-->
    <joint name = "J2" type = "continuous">
      <parent link = "porteria_link"/>
      <child link = "panel_link"/>  
      <origin xyz ="0 0 0.2625" rpy = "0 0 0"/>
      <axis xyz = "1 0 0"/>
    </joint>


    

</robot>